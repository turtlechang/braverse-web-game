{
  "name": "braverse-web-game",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "server:dev": "tsx watch server/src/index.ts",
    "server:start": "tsx server/src/index.ts",
    "server:typecheck": "tsc --noEmit -p server/tsconfig.json",
    "typecheck": "tsc -b && npm run server:typecheck",
    "validate:cards": "tsx scripts/validate-cards.ts",
    "cards:audit:contracts": "tsx scripts/validate-card-contracts.ts",
    "cards:attest": "tsx scripts/attest-card-contract.ts",
    "cards:migrate:batch": "tsx scripts/migrate-card-contract-batch.ts",
    "validate:candidate": "tsx scripts/validate-candidate-cards.ts",
    "promote:candidate": "tsx scripts/promote-candidate-cards.ts",
    "generate:card-pool": "tsx scripts/generate-card-pool.ts",
    "check:card-pool": "tsx scripts/generate-card-pool.ts --check",
    "dev:online": "concurrently \"npm run dev\" \"npm run server:dev\"",
    "cards:import:sample": "node scripts/import-official-cards.mjs --limit 100",
    "cards:import:red-sample": "node scripts/import-official-cards.mjs --category-title \"Starter Deck RED\" --output data/cards/official-sample.en.json --limit 100",
    "cards:import:yellow-sample": "node scripts/import-official-cards.mjs --category-title \"Starter Deck YELLOW\" --output data/cards/official-starter-deck-yellow.en.json --limit 100",
    "cards:import:green-sample": "node scripts/import-official-cards.mjs --category-title \"Starter Deck GREEN\" --output data/cards/official-starter-deck-green.en.json --limit 100",
    "cards:import:blue-sample": "node scripts/import-official-cards.mjs --category-title \"Starter Deck BLUE\" --output data/cards/official-starter-deck-blue.en.json --limit 100",
    "cards:import:purple-sample": "node scripts/import-official-cards.mjs --category-title \"Starter Deck PURPLE\" --output data/cards/official-starter-deck-purple.en.json --limit 100",
    "cards:import:brave-beginning": "node scripts/import-brave-beginning.mjs",
    "cards:import:bs3-candidate": "node scripts/import-bs3-candidates.mjs",
    "cards:analyze:bs3-candidate": "tsx scripts/analyze-bs3-effect-coverage.ts",
      "cards:import:bs4-candidate": "node scripts/import-bs4-candidates.mjs",
      "cards:analyze:bs4-candidate": "tsx scripts/analyze-bs4-effect-coverage.ts",
      "cards:import:bs5-candidate": "node scripts/import-bs5-candidates.mjs",
      "cards:import:bs6-candidate": "node scripts/import-bs6-candidates.mjs",
      "cards:import:p-candidate": "node scripts/import-p-candidates.mjs",
    "cards:analyze:bs5-candidate": "tsx scripts/analyze-bs5-effect-coverage.ts",
    "cards:analyze:bs6": "tsx scripts/analyze-bs6-effect-coverage.ts",
    "cards:analyze:bs6-candidate": "npm run cards:analyze:bs6",
    "verify:bs5-bs6:semantics": "tsx scripts/verify-bs5-bs6-semantics.ts bs5 && tsx scripts/verify-bs5-bs6-semantics.ts bs6",
    "benchmark:bs4-decks": "tsx scripts/benchmark-bs4-decks.ts",
    "benchmark:bs5-decks": "tsx scripts/benchmark-bs5-decks.ts",
    "benchmark:bs6-decks": "tsx scripts/benchmark-bs6-decks.ts",
    "benchmark:bs6-competitive:round-robin": "tsx scripts/benchmark-bs6-competitive-round-robin.ts",
    "benchmark:bs1-bs6:generate": "tsx scripts/generate-bs1-bs6-512-roster.ts",
    "benchmark:bs1-bs6:iterate": "tsx scripts/generate-bs1-bs6-512-roster.ts --iteration",
    "test:bs1-bs6:512:browser": "node scripts/bs1-bs6-512-swiss-browser.mjs",
    "benchmark:bs6-competitive": "set BS6_BENCHMARK_MODE=competitive&& set BS6_BENCHMARK_OUTPUT=data/decks/bs6-competitive-benchmark-report-100-standard.json&& npm run benchmark:bs6-decks",
    "lint": "eslint . --max-warnings=0",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "test": "vitest run",
    "test:ai:browser": "node scripts/ai-browser-validation.mjs",
    "test:browser:smoke": "npm run test:ai:browser && npm run test:deck:browser && npm run test:online:match:browser",
    "test:deployment:browser": "node scripts/deployment-browser-validation.mjs",
    "test:bs4:cards:browser": "node scripts/bs4-browser-card-audit.mjs",
    "test:bs4:interaction:browser": "node scripts/bs4-browser-interaction-validation.mjs",
    "test:p:cards:browser": "node scripts/p-browser-card-audit.mjs",
    "test:p:effects:browser": "node scripts/p-browser-effect-audit.mjs",
    "test:bs5:effects:browser": "node scripts/p-browser-effect-audit.mjs --series=BS5",
    "test:bs6:effects:browser": "node scripts/p-browser-effect-audit.mjs --series=BS6",
    "test:bs6:decks:browser": "node scripts/bs6-deck-browser-validation.mjs",
    "test:bs6-079:rest-support:browser": "node scripts/bs6-079-multi-target-probe.mjs",
    "test:bs6:competitive:decks:browser": "set BS6_DECK_BROWSER_MODE=competitive&& node scripts/bs6-deck-browser-validation.mjs",
    "test:bs3-yellow:browser": "node scripts/bs3-yellow-battle-validation.mjs",
    "test:bs3-red:browser": "set BS3_DECK=bs3-red-pitaya && node scripts/bs3-yellow-battle-validation.mjs",
    "test:bs3-blue:browser": "set BS3_DECK=bs3-blue-sorbet && node scripts/bs3-yellow-battle-validation.mjs",
    "test:bs3-green:browser": "set BS3_DECK=bs3-green-lily && node scripts/bs3-yellow-battle-validation.mjs",
    "test:bs3-purple:browser": "set BS3_DECK=bs3-purple-dark-cacao && node scripts/bs3-yellow-battle-validation.mjs",
    "test:deck:browser": "node scripts/deck-editor-browser-validation.mjs",
    "test:online:browser": "node scripts/online-modal-browser-validation.mjs",
    "test:online:match:browser": "node scripts/online-match-browser-validation.mjs",
    "test:blue:browser": "node scripts/blue-card-validation.mjs",
    "test:bs2:cards:browser": "node scripts/bs2-purple-blue-card-validation.mjs",
    "test:bs2:cards:ryg:browser": "node scripts/bs2-red-yellow-green-card-validation.mjs",
    "test:watch": "vitest",
    "test:benchmark": "node --test scripts/opencode-go-benchmark.test.js",
    "test:opencode": "node --test scripts/lib/classify-opencode-error.test.mjs scripts/lib/parse-opencode-error.test.mjs scripts/opencode-go-health-check.test.mjs scripts/opencode-go-wrapper.test.mjs",
    "test:all": "npm test && npm run test:opencode",
    "benchmark:opencode-go": "node scripts/opencode-go-benchmark.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
