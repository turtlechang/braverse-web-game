{
  "$schema": "https://opencode.ai/config.json",
      "model": "opencode-go/mimo-v2.5",
  "agent": {
    "review-fast": {
      "description": "Bounded read-only code review for delegated checks",
      "mode": "primary",
  "model": "opencode-go/mimo-v2.5",
      "temperature": 0.1,
      "steps": 2,
      "prompt": "You are a bounded read-only code reviewer. Inspect only the files explicitly named by the user. Use at most one batched tool round, read no more than four focused file sections, and then return findings immediately. Prioritize correctness, regressions, security, and missing tests. Do not run commands, edit files, invoke subagents, browse the web, or continue exploring after the first tool round. If the requested scope is too broad, review the highest-risk files and state what was not inspected.",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "external_directory": "deny",
        "todowrite": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "lsp": "deny",
        "skill": "deny",
        "question": "deny"
      }
    }
  },
  "provider": {
    "opencode-go": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Go",
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1",
        "apiKey": "{env:OPENCODE_GO_API_KEY}"
      },
      "models": {
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        },
        "glm-5": {
          "name": "GLM-5"
        },
        "glm-5.1": {
          "name": "GLM-5.1"
        },
        "kimi-k2.6": {
          "name": "Kimi K2.6"
        },
        "kimi-k2.7-code": {
          "name": "Kimi K2.7 Code"
        },
        "mimo-v2.5": {
          "name": "MiMo V2.5"
        },
        "mimo-v2.5-pro": {
          "name": "MiMo V2.5 Pro"
        },
        "minimax-m2.7": {
          "name": "MiniMax M2.7"
        },
        "minimax-m3": {
          "name": "MiniMax M3（3x usage）"
        },
        "qwen3.6-plus": {
          "name": "Qwen 3.6 Plus"
        },
        "qwen3.7-max": {
          "name": "Qwen 3.7 Max"
        },
        "qwen3.7-plus": {
          "name": "Qwen 3.7 Plus"
        }
      }
    }
  }
}
